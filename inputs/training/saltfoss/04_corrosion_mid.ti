! =============================================================================
! SaltFoss Training — Segment 5 (0:40-0:52): Corrosion follows redox (2/3)
! =============================================================================
! F = 135.5 (the U(IV)/U(III)=1 midpoint from Segment 4). Dissolved Cr should
! already be ~7 orders of magnitude higher than 04_corrosion_reducing.ti.
!
! Run:    ./bin/InputScriptMode inputs/training/saltfoss/04_corrosion_mid.ti
! Verified output: Cr2+ = 3.65e-07,  Cr3+ = 1.82e-10
! =============================================================================
temperature       = 900
pressure          = 1.0
mass(3)           = 66.0       ! Li
mass(4)           = 33.0       ! Be
mass(92)          = 1.0        ! U
mass(24)          = 0.01       ! Cr  -- structural-alloy tracer
mass(9)           = 135.5      ! F   -- midpoint (U(IV)/U(III) ~ 1)
temperature unit  = K
pressure unit     = atm
mass unit         = moles
data file         = data/MSD-TC_V4.1_Fluorides_No_Func.dat
print mode        = 2
