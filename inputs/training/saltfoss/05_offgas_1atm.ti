! =============================================================================
! SaltFoss Training — Segment 6 (0:52-0:58): Off-gassing (1/2) -- no boiling
! =============================================================================
! Same base salt plus trace Cs and I (classic volatile fission products),
! at 1 atm -- a normal operating pressure. Teaching point: a clean FLiBe
! melt simply does NOT boil at 1 atm, so a naive run at atmospheric pressure
! tells you nothing about volatile release. Compare against
! 05_offgas_lowP.ti, which asks the same question at a pressure where vapor
! actually matters.
!
! Run:    ./bin/InputScriptMode inputs/training/saltfoss/05_offgas_1atm.ti
! Verified: gas_ideal is NOT a stable phase (moles = 0) at 1 atm.
! =============================================================================
temperature       = 1200
pressure          = 1.0
mass(3)           = 66.0       ! Li
mass(4)           = 33.0       ! Be
mass(92)          = 1.0        ! U
mass(55)          = 0.02       ! Cs -- volatile fission product
mass(53)          = 0.02       ! I  -- volatile fission product
mass(9)           = 135.0      ! F
temperature unit  = K
pressure unit     = atm
mass unit         = moles
data file         = data/MSD-TC_V4.1_Fluorides_No_Func.dat
print mode        = 2
